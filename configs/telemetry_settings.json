{
  "sampling_rate_hz": 10.0,
  "recommended_physics_dt_s": 0.1,
  "provenance": {
    "default_source": "simulator_v1_physics",
    "default_source_type": "synthetic",
    "simulation_version": "0.2.0-phase2b-physics"
  },
  "notes": {
    "architecture": "One TelemetryRecord is emitted per physics integration step. At the recommended dt=0.1s, this produces 10 Hz telemetry. RK4 sub-stepping occurs internally within each physics step (max_sub_dt=0.02s) and is not visible at the telemetry level.",
    "timestamp_semantics": "TelemetryRecord.timestamp = cumulative simulation elapsed time in seconds, monotonically increasing by dt per record."
  },
  "channels": {
    "altitude": {"unit": "m", "description": "Pressure/GPS altitude"},
    "ambient_temp": {"unit": "deg_C", "description": "Outside Air Temperature"},
    "throttle": {"unit": "percent", "description": "Throttle position command"},
    "load": {"unit": "percent", "description": "Engine load factor"},
    "rpm": {"unit": "RPM", "description": "Engine crankshaft speed"},
    "cht": {"unit": "deg_C", "description": "Cylinder Head Temperature"},
    "egt": {"unit": "deg_C", "description": "Exhaust Gas Temperature"},
    "oil_temp": {"unit": "deg_C", "description": "Engine oil temperature"},
    "oil_pressure": {"unit": "bar", "description": "Engine oil pressure"},
    "fuel_flow": {"unit": "L/h", "description": "Fuel consumption rate"},
    "vibration": {"unit": "g", "description": "Mount vibration amplitude"}
  }
}
